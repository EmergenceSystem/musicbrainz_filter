{application, musicbrainz_filter, [
    {description, "em_filter agent for MusicBrainz music metadata search"},
    {vsn, "0.2.0"},
    {registered, [musicbrainz_filter_sup, musicbrainz_filter_server]},
    {mod, {musicbrainz_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        musicbrainz_filter_sup,
        musicbrainz_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/musicbrainz_filter"}]}
]}.
